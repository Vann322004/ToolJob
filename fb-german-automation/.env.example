# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/fb_german_automation

# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Nano Banana / Image Remaster Service (Optional custom endpoint)
NANO_BANANA_API_URL=
NANO_BANANA_API_KEY=

# Meta Business Suite / Facebook Graph API
META_GRAPH_API_VERSION=v19.0
# Set to true to allow testing without valid Meta tokens
SIMULATE_META_PUBLISH=true

# Automation Settings
WORKER_INTERVAL_MS=7000
DAILY_POSTS_PER_PAGE=7
DEFAULT_TIMEZONE=Europe/Berlin
